# Copy this file to .env.local and fill in your real Supabase project values.
# If these are left unset, the app automatically runs in Demo Mode using
# in-memory mock data shaped like the real schema (see src/lib/demoData.ts).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_BACKEND_WEBHOOK_URL=http://localhost:8000/webhook/ledgerzero-ingest
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET=invoices
